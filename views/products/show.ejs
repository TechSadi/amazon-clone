<% layout('layouts/base') %>
<% block('title', product.name) %>
<% block('description', product.name) %>
<% block('styles', '<link rel="stylesheet" href="/styles/pages/product-detail.css">') %>
<% block('scripts', '<script src="/scripts/products.js" defer></script>') %>

<%
    const price = (product.priceCents / 100).toFixed(2);
    const keywords = Array.isArray(product.keywords) ? product.keywords : [];
    const primaryCategory = product.category || keywords[0] || null;
%>

<main class="page" id="main">

    <div class="container">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol class="breadcrumb__list">
                <li><a href="/products">All products</a></li>

                <% if (primaryCategory) { %>
                    <li>
                        <a class="breadcrumb__term" href="/products?q=<%= encodeURIComponent(primaryCategory) %>">
                            <%= primaryCategory %>
                        </a>
                    </li>
                <% } %>

                <li aria-current="page"><%= product.name %></li>
            </ol>
        </nav>

        <div class="product-detail">

            <!-- Gallery -->
            <div class="product-detail__gallery">
                <div class="product-detail__frame">
                    <img
                        class="product-detail__image"
                        src="/<%= product.image %>"
                        alt="<%= product.name %>"
                        decoding="async"
                    >
                </div>
            </div>

            <!-- Information -->
            <div class="product-detail__info">

                <h1 class="product-detail__title"><%= product.name %></h1>

                <%- include('../partials/rating', {
                    ratingStars: product.rating.stars,
                    ratingCount: product.rating.count
                }) %>

                <hr>

                <p class="price price--lg product-detail__price">
                    <span class="price__symbol">$</span><%= price %>
                </p>

                <p class="product-detail__tax-note">
                    Tax is calculated at checkout.
                </p>

                <% if (keywords.length > 0) { %>
                    <div class="product-detail__section">
                        <h2 class="product-detail__section-title">About this item</h2>

                        <ul class="tag-list">
                            <% keywords.forEach((keyword) => { %>
                                <li>
                                    <a class="tag" href="/products?q=<%= encodeURIComponent(keyword) %>">
                                        <%= keyword %>
                                    </a>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <div class="product-detail__section">
                    <h2 class="product-detail__section-title">Product details</h2>

                    <dl class="spec-list">
                        <% if (primaryCategory) { %>
                            <div class="spec-list__row">
                                <dt>Category</dt>
                                <dd class="spec-list__term"><%= primaryCategory %></dd>
                            </div>
                        <% } %>

                        <div class="spec-list__row">
                            <dt>Customer rating</dt>
                            <dd>
                                <%= product.rating.stars %> out of 5
                                (<%= (product.rating.count || 0).toLocaleString('en-US') %>
                                <%= product.rating.count === 1 ? 'review' : 'reviews' %>)
                            </dd>
                        </div>

                        <div class="spec-list__row">
                            <dt>Price</dt>
                            <dd>$<%= price %></dd>
                        </div>

                        <div class="spec-list__row">
                            <dt>Sold by</dt>
                            <dd>Amazon Clone</dd>
                        </div>
                    </dl>
                </div>

            </div>

            <!-- Buy box -->
            <aside class="buy-box" aria-label="Purchase options">

                <p class="price price--lg">
                    <span class="price__symbol">$</span><%= price %>
                </p>

                <p class="buy-box__delivery">
                    <% if (standardDelivery.priceCents === 0) { %>
                        <strong class="buy-box__free">FREE delivery</strong>
                    <% } else { %>
                        <strong>$<%= (standardDelivery.priceCents / 100).toFixed(2) %> delivery</strong>
                    <% } %>
                    <span><%= standardDelivery.date %></span>
                </p>

                <p class="buy-box__delivery-fast">
                    Or fastest delivery <strong><%= fastestDelivery.date %></strong>
                    for $<%= (fastestDelivery.priceCents / 100).toFixed(2) %>
                </p>

                <p class="buy-box__stock">In stock</p>

                <div class="buy-box__quantity">
                    <label class="field__label" for="qty-<%= product._id %>">
                        Quantity
                    </label>

                    <select
                        id="qty-<%= product._id %>"
                        class="select js-quantity-select"
                        data-product-id="<%= product._id %>"
                    >
                        <% for (let value = 1; value <= 10; value++) { %>
                            <option value="<%= value %>"><%= value %></option>
                        <% } %>
                    </select>
                </div>

                <div class="buy-box__actions">
                    <button
                        type="button"
                        class="btn btn--primary btn--pill btn--block js-add-to-cart"
                        data-product-id="<%= product._id %>"
                        data-product-name="<%= product.name %>"
                    >
                        Add to cart
                    </button>

                    <button
                        type="button"
                        class="btn btn--dark btn--pill btn--block js-buy-now"
                        data-product-id="<%= product._id %>"
                    >
                        Buy now
                    </button>
                </div>

                <ul class="buy-box__assurances">
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3l7 3v5.5c0 4.2-2.9 7.8-7 9-4.1-1.2-7-4.8-7-9V6z" />
                            <path d="M9 12l2 2 4-4" />
                        </svg>
                        Secure transaction
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 7h11v10H3z" />
                            <path d="M14 10h4l3 3v4h-7z" />
                            <circle cx="7" cy="17.5" r="1.6" />
                            <circle cx="17" cy="17.5" r="1.6" />
                        </svg>
                        Ships from Amazon Clone
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 9a8 8 0 1 1 .6 5" />
                            <path d="M4 4v5h5" />
                        </svg>
                        30-day returns
                    </li>
                </ul>

            </aside>

        </div>

    </div>

</main>
