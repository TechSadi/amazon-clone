# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---- Required ----

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/amazon-clone

# Signs the session cookie. Use a long random value, unique per
# environment, and at least 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-value

# ---- Optional ----

# development | production
NODE_ENV=development

# Port the server listens on.
PORT=3000

# Name of the session cookie.
SESSION_NAME=amazon.sid

# bcrypt cost factor (10-15). Higher is slower and stronger.
BCRYPT_ROUNDS=12

# Set to true when running behind a reverse proxy (Render, Heroku,
# nginx) so secure cookies and client IPs work. Always on in production.
TRUST_PROXY=false
