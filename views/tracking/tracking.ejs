<% layout('layouts/base') %>
<% block('title', 'Track package') %>
<% block('styles', '<link rel="stylesheet" href="' + asset('/styles/pages/tracking.css') + '">') %>
<% block('scripts', '<script src="' + asset('/scripts/tracking.js') + '" defer></script>') %>

<%
    const stage = percentProgress >= 100
        ? 'delivered'
        : percentProgress >= 50
          ? 'shipped'
          : 'preparing';

    const steps = [
        { key: 'preparing', label: 'Preparing', caption: 'We are packing your order.' },
        { key: 'shipped', label: 'Shipped', caption: 'Your package is on its way.' },
        { key: 'delivered', label: 'Delivered', caption: 'Left at your address.' }
    ];

    const currentIndex = steps.findIndex((step) => step.key === stage);
%>

<main class="page" id="main">

    <div class="container container--narrow">

        <a class="link link-back tracking__back" href="/orders">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 5l-7 7 7 7" />
            </svg>
            All orders
        </a>

        <div class="card card--padded">

            <p class="tracking__status">
                <% if (stage === 'delivered') { %>
                    <span class="badge badge--success">Delivered</span>
                <% } else { %>
                    <span class="badge badge--info">On the way</span>
                <% } %>
            </p>

            <h1 class="tracking__date">
                <% if (stage === 'delivered') { %>
                    Delivered <%= deliveryDate %>
                <% } else { %>
                    Arriving <%= deliveryDate %>
                <% } %>
            </h1>

            <div class="tracking__item">

                <div class="tracking__media">
                    <img src="/<%= item.image %>" alt="" loading="lazy" decoding="async">
                </div>

                <div>
                    <h2 class="tracking__name"><%= item.name %></h2>
                    <p class="text-muted">Quantity: <%= item.quantity %></p>
                </div>

            </div>

            <div class="tracking__progress">

                <div
                    class="tracking__bar"
                    role="progressbar"
                    aria-valuenow="<%= percentProgress %>"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label="Delivery progress"
                >
                    <span class="tracking__bar-fill js-progress-bar" data-progress="<%= percentProgress %>"></span>
                </div>

                <ol class="tracking__steps">
                    <% steps.forEach((step, index) => { %>
                        <li class="tracking__step <%= index <= currentIndex ? 'is-complete' : '' %> <%= index === currentIndex ? 'is-current' : '' %>">
                            <span class="tracking__step-marker" aria-hidden="true"></span>
                            <span class="tracking__step-label"><%= step.label %></span>
                            <span class="tracking__step-caption"><%= step.caption %></span>
                        </li>
                    <% }) %>
                </ol>

            </div>

        </div>

    </div>

</main>
