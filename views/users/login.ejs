<% layout('layouts/focused') %>
<% block('title', 'Sign in') %>
<% block('styles', '<link rel="stylesheet" href="/styles/pages/auth.css">') %>
<% block('scripts', '<script src="/scripts/auth-form.js" defer></script>') %>

<main class="page auth-page" id="main">

    <section class="card card--padded auth-card" aria-labelledby="auth-heading">

        <div class="auth-card__header">
            <h1 id="auth-heading">Sign in</h1>
            <p class="text-muted">Welcome back. Sign in to continue shopping.</p>
        </div>

        <% if (error) { %>
            <div class="alert alert--error" role="alert">
                <svg class="alert__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7.5v5" />
                    <path d="M12 16.2h.01" />
                </svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/users/login" method="POST" class="js-validated-form" novalidate>

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="field">
                <label class="field__label" for="email">Email</label>

                <div class="input-group">
                    <svg class="input-group__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="M3 7l9 6 9-6" />
                    </svg>

                    <input
                        class="input"
                        type="email"
                        id="email"
                        name="email"
                        value="<%= formData && formData.email ? formData.email : '' %>"
                        placeholder="you@example.com"
                        autocomplete="email"
                        data-label="your email"
                        aria-describedby="email-error"
                        required
                    >
                </div>

                <p class="field__error" id="email-error"></p>
            </div>

            <div class="field">
                <div class="field__label-row">
                    <label class="field__label" for="password">Password</label>
                    <a class="link auth-card__forgot" href="/users/register">
                        Forgot password?
                    </a>
                </div>

                <div class="input-group">
                    <svg class="input-group__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="5" y="10" width="14" height="10" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>

                    <input
                        class="input"
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        data-label="your password"
                        aria-describedby="password-error"
                        required
                    >

                    <button
                        type="button"
                        class="input-group__action js-toggle-password"
                        data-target="password"
                        aria-label="Show password"
                        aria-pressed="false"
                    >
                        <%- include('../partials/eye-icons') %>
                    </button>
                </div>

                <p class="field__error" id="password-error"></p>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">
                Sign in
            </button>

        </form>

        <p class="auth-card__terms">
            By continuing you agree to our
            <a class="link" href="/products">conditions of use</a> and
            <a class="link" href="/products">privacy notice</a>.
        </p>

        <%- include('../partials/social-buttons', {
            dividerLabel: 'or continue with'
        }) %>

        <div class="auth-card__switch">
            <span>New to Amazon Clone?</span>
            <a class="btn btn--secondary btn--block" href="/users/register">
                Create your account
            </a>
        </div>

    </section>

</main>
