<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create your account</title>

    <link rel="stylesheet" href="/styles/pages/users/register.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <script src="/scripts/users/register.js" defer></script>
</head>

<body>

    <main class="auth-page">

        <a href="/products" class="logo-container">

            <img src="/images/amazon-logo-white.png" alt="Amazon" class="amazon-logo">

        </a>


        <section class="auth-card">

            <div class="auth-header">

                <h1>Create your account</h1>

                <p>
                    Join us and start shopping.
                </p>

            </div>


            <% if (error) { %>

                <div class="server-error">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 7v5"></path>
                        <circle cx="12" cy="16.5" r="1"></circle>
                    </svg>

                    <span>
                        <%= error %>
                    </span>

                </div>

                <% } %>


                    <form action="/users/register" method="POST" id="register-form" novalidate>

                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <!-- NAME -->

                        <div class="form-group">

                            <label for="name">
                                Your name
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                                </svg>

                                <input type="text" id="name" name="name" placeholder="First and last name"
                                    value="<%= formData?.name || '' %>" autocomplete="name">

                            </div>

                            <p class="field-message" id="name-error"></p>

                        </div>


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label for="email">
                                Email
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>

                                    <path d="M3 7l9 6 9-6"></path>
                                </svg>

                                <input type="email" id="email" name="email" placeholder="Enter your email"
                                    value="<%= formData?.email || '' %>" autocomplete="email">

                            </div>

                            <p class="field-message" id="email-error"></p>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <label for="password">
                                Password
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                </svg>

                                <input type="password" id="password" name="password" placeholder="At least 8 characters"
                                    autocomplete="new-password">

                                <button type="button" class="toggle-password" data-target="password"
                                    aria-label="Show password">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>

                            </div>

                            <div class="password-hint">

                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <path d="M12 10v5"></path>
                                    <circle cx="12" cy="7" r="1"></circle>
                                </svg>

                                <span>
                                    Password must be at least 8 characters.
                                </span>

                            </div>

                            <p class="field-message" id="password-error"></p>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="form-group">

                            <label for="confirmPassword">
                                Re-enter password
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                                </svg>

                                <input type="password" id="confirmPassword" name="confirmPassword"
                                    placeholder="Re-enter your password" autocomplete="new-password">

                                <button type="button" class="toggle-password" data-target="confirmPassword"
                                    aria-label="Show password">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>

                            </div>

                            <p class="field-message" id="confirmPassword-error"></p>

                        </div>


                        <button type="submit" class="create-account-button">
                            <span>Create account</span>
                        </button>

                    </form>


                    <p class="terms-text">

                        By creating an account, you agree to our

                        <a href="#">
                            Conditions of Use
                        </a>

                        and

                        <a href="#">
                            Privacy Notice
                        </a>.

                    </p>


                    <!-- SOCIAL SIGN-UP -->

                    <%- include('../partials/social-buttons', {
                        dividerClass: 'divider',
                        dividerLabel: 'or sign up with'
                    }) %>


                    <div class="signin-section">

                        <span>
                            Already have an account?
                        </span>

                        <a href="/users/login">
                            Sign in
                            <span class="arrow">›</span>
                        </a>

                    </div>

        </section>


        <footer class="auth-footer">

            <div class="footer-links">

                <a href="#">Conditions of Use</a>
                <a href="#">Privacy Notice</a>
                <a href="#">Help</a>

            </div>

            <p>
                © 2026 Amazon Clone Project
            </p>

        </footer>

    </main>

</body>

</html>