<% layout('layouts/focused') %>
<% block('title', 'Checkout') %>
<% block('styles', '<link rel="stylesheet" href="/styles/pages/checkout.css">') %>
<% block('scripts', '<script src="/scripts/checkout.js" defer></script>') %>

<% block('focusedHeader', `
    <p class="focused-header__title">
        Checkout
        <span class="text-muted js-cart-label">${
            cartQuantity === 1 ? '1 item' : cartQuantity + ' items'
        }</span>
    </p>

    <p class="focused-header__meta">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="5" y="10.5" width="14" height="9.5" rx="2"></rect>
            <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"></path>
        </svg>
        Secure checkout
    </p>
`) %>

<main class="page" id="main">

    <div class="container">

        <% if (cart.items.length === 0) { %>

            <div class="card">
                <div class="empty-state">

                    <span class="empty-state__art">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2.5 4h2.4l2.2 10.6a1.7 1.7 0 0 0 1.7 1.4h8.4a1.7 1.7 0 0 0 1.6-1.3L20.5 8H6" />
                            <circle cx="9.5" cy="19.5" r="1.5" />
                            <circle cx="17" cy="19.5" r="1.5" />
                        </svg>
                    </span>

                    <h1 class="empty-state__title">There is nothing to check out</h1>

                    <p class="empty-state__message">
                        Your cart is empty. Add something to it and come back to
                        complete your order.
                    </p>

                    <div class="empty-state__actions">
                        <a class="btn btn--primary" href="/products">
                            Continue shopping
                        </a>
                    </div>

                </div>
            </div>

        <% } else { %>

            <div class="page-header">
                <h1 class="page-title">Review your order</h1>

                <a class="link link-back" href="/cart">
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 5l-7 7 7 7" />
                    </svg>
                    Back to cart
                </a>
            </div>

            <div class="checkout-layout">

                <section class="checkout-items js-checkout-list" aria-label="Items in this order" data-max-quantity="<%= maxItemQuantity %>">

                    <% cart.items.forEach((item) => { %>

                        <%
                            const productId = item.product._id;
                            const selectedOption = getDeliveryOption(item.deliveryOptionId);
                            const linePrice = (
                                (item.product.priceCents * item.quantity) / 100
                            ).toFixed(2);
                        %>

                        <article class="card checkout-item js-checkout-item" data-product-id="<%= productId %>">

                            <p class="checkout-item__eta js-delivery-date" data-product-id="<%= productId %>">
                                Delivery date: <%= deliveryDateLabel(selectedOption) %>
                            </p>

                            <div class="checkout-item__grid">

                                <a class="checkout-item__media" href="/products/<%= productId %>" tabindex="-1" aria-hidden="true">
                                    <img src="/<%= item.product.image %>" alt="" loading="lazy" decoding="async">
                                </a>

                                <div class="checkout-item__details">

                                    <h2 class="checkout-item__title">
                                        <a href="/products/<%= productId %>">
                                            <span class="clamp-2"><%= item.product.name %></span>
                                        </a>
                                    </h2>

                                    <p class="price price--accent checkout-item__price js-item-price" data-product-id="<%= productId %>">
                                        $<%= linePrice %>
                                    </p>

                                    <div class="checkout-item__actions">

                                        <div class="stepper js-stepper" data-product-id="<%= productId %>">
                                            <button
                                                type="button"
                                                class="stepper__button js-decrease"
                                                data-product-id="<%= productId %>"
                                                <%= item.quantity <= 1 ? 'disabled' : '' %>
                                            >
                                                <span aria-hidden="true">&minus;</span>
                                                <span class="visually-hidden">
                                                    Decrease quantity of <%= item.product.name %>
                                                </span>
                                            </button>

                                            <span
                                                class="stepper__value js-quantity"
                                                data-product-id="<%= productId %>"
                                                role="status"
                                            ><%= item.quantity %></span>

                                            <button
                                                type="button"
                                                class="stepper__button js-increase"
                                                data-product-id="<%= productId %>"
                                                <%= item.quantity >= maxItemQuantity ? 'disabled' : '' %>
                                            >
                                                <span aria-hidden="true">+</span>
                                                <span class="visually-hidden">
                                                    Increase quantity of <%= item.product.name %>
                                                </span>
                                            </button>
                                        </div>

                                        <button
                                            type="button"
                                            class="btn btn--sm btn--danger js-remove-item"
                                            data-product-id="<%= productId %>"
                                            data-product-name="<%= item.product.name %>"
                                        >
                                            Remove
                                        </button>

                                    </div>

                                </div>

                                <fieldset class="delivery-options">

                                    <legend class="delivery-options__title">
                                        Choose a delivery option
                                    </legend>

                                    <% deliveryOptions.forEach((option) => { %>

                                        <%
                                            const inputId = 'delivery-' + productId + '-' + option.id;
                                            const isChecked = option.id === item.deliveryOptionId;
                                        %>

                                        <div class="delivery-option">

                                            <input
                                                type="radio"
                                                class="delivery-option__input js-delivery-option"
                                                id="<%= inputId %>"
                                                name="delivery-option-<%= productId %>"
                                                value="<%= option.id %>"
                                                data-product-id="<%= productId %>"
                                                <%= isChecked ? 'checked' : '' %>
                                            >

                                            <label class="delivery-option__label" for="<%= inputId %>">
                                                <span class="delivery-option__date">
                                                    <%= deliveryDateLabel(option) %>
                                                </span>

                                                <span class="delivery-option__price">
                                                    <% if (option.priceCents === 0) { %>
                                                        FREE shipping
                                                    <% } else { %>
                                                        $<%= (option.priceCents / 100).toFixed(2) %> shipping
                                                    <% } %>
                                                </span>
                                            </label>

                                        </div>

                                    <% }) %>

                                </fieldset>

                            </div>

                        </article>

                    <% }) %>

                </section>

                <aside class="card card--padded order-summary" aria-labelledby="summary-heading">

                    <h2 class="order-summary__title" id="summary-heading">Order summary</h2>

                    <dl class="order-summary__rows">

                        <div class="order-summary__row">
                            <dt>Items (<span class="js-cart-count"><%= cartQuantity %></span>)</dt>
                            <dd class="js-subtotal">$<%= subtotal %></dd>
                        </div>

                        <div class="order-summary__row">
                            <dt>Shipping &amp; handling</dt>
                            <dd class="js-shipping">$<%= totalShippingCost %></dd>
                        </div>

                        <div class="order-summary__row order-summary__row--rule">
                            <dt>Total before tax</dt>
                            <dd class="js-total-before-tax">$<%= totalBeforeTax %></dd>
                        </div>

                        <div class="order-summary__row">
                            <dt>Estimated tax (10%)</dt>
                            <dd class="js-estimated-tax">$<%= estimatedTax %></dd>
                        </div>

                        <div class="order-summary__row order-summary__row--total">
                            <dt>Order total</dt>
                            <dd class="js-order-total">$<%= orderTotal %></dd>
                        </div>

                    </dl>

                    <button type="button" class="btn btn--primary btn--lg btn--block js-place-order">
                        Place your order
                    </button>

                    <p class="order-summary__note">
                        By placing your order you agree to the terms of this demo
                        store. No payment is taken.
                    </p>

                </aside>

            </div>

        <% } %>

    </div>

</main>

<div class="overlay js-order-overlay">
    <div class="overlay__box">

        <div class="success-mark">
            <svg viewBox="0 0 52 52" aria-hidden="true">
                <circle class="success-mark__circle" cx="26" cy="26" r="24" />
                <path class="success-mark__check" d="M14 27 L22 35 L38 18" />
            </svg>
        </div>

        <p class="overlay__title">Order placed</p>
        <p class="overlay__message">Taking you to your orders...</p>

    </div>
</div>
