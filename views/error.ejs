<% layout('layouts/focused') %>
<% block('title', title) %>
<% block('styles', '<link rel="stylesheet" href="' + asset('/styles/pages/error.css') + '">') %>

<main class="page error-page" id="main">

    <div class="card card--padded error-card">

        <p class="error-card__status"><%= status %></p>

        <h1 class="error-card__title"><%= title %></h1>

        <p class="error-card__message"><%= message %></p>

        <div class="error-card__actions">
            <a class="btn btn--primary" href="/products">Go to the store</a>

            <% if (status >= 500 || status === 429) { %>
                <button type="button" class="btn btn--secondary" data-action="reload">
                    Try again
                </button>
            <% } %>

            <% if (status === 401) { %>
                <a class="btn btn--secondary" href="/users/login">Sign in</a>
            <% } %>
        </div>

        <% if (detail) { %>
            <details class="error-card__detail">
                <summary>Developer details</summary>
                <pre><%= detail %></pre>
            </details>
        <% } %>

    </div>

</main>
