<%#
  Social sign-in buttons.

  Rendered from app.locals.socialProviders, which is built at boot from
  the configured credentials. A provider without credentials produces no
  button, so this block can never show a control that does nothing.

  Expects: dividerLabel
%>
<% if (socialProviders && socialProviders.length > 0) { %>

    <div class="auth-divider">
        <span><%= dividerLabel %></span>
    </div>

    <div class="social-buttons">

        <% socialProviders.forEach((provider) => { %>

            <a class="btn btn--secondary btn--block social-button" href="<%= provider.href %>" rel="nofollow">

                <% if (provider.name === 'google') { %>

                    <svg class="social-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="#4285F4"
                            d="M21.35 12.27c0-.79-.07-1.55-.2-2.27H12v4.3h5.23a4.47 4.47 0 0 1-1.94 2.94v2.78h3.14c1.84-1.69 2.92-4.18 2.92-7.75z" />
                        <path fill="#34A853"
                            d="M12 21.75c2.63 0 4.84-.87 6.45-2.36l-3.14-2.78c-.87.58-1.98.92-3.31.92-2.55 0-4.71-1.72-5.48-4.03H3.28v2.87A9.75 9.75 0 0 0 12 21.75z" />
                        <path fill="#FBBC05"
                            d="M6.52 13.5A5.86 5.86 0 0 1 6.21 12c0-.52.09-1.02.31-1.5V7.63H3.28A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.05 1.03 4.37l3.24-2.87z" />
                        <path fill="#EA4335"
                            d="M12 6.47c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.83 3.53 14.62 2.25 12 2.25A9.75 9.75 0 0 0 3.28 7.63l3.24 2.87C7.29 8.19 9.45 6.47 12 6.47z" />
                    </svg>

                <% } else if (provider.name === 'github') { %>

                    <svg class="social-button__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path
                            d="M12 .7a11.3 11.3 0 0 0-3.57 22c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.34-3.8-1.34-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.51-.29-5.15-1.26-5.15-5.6 0-1.24.44-2.25 1.16-3.05-.12-.29-.5-1.45.11-3.02 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.57.23 2.73.11 3.02.72.8 1.16 1.81 1.16 3.05 0 4.35-2.64 5.3-5.16 5.59.4.35.76 1.04.76 2.1v3.12c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7z" />
                    </svg>

                <% } else if (provider.name === 'microsoft') { %>

                    <svg class="social-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="#f25022" d="M1 1h10v10H1z" />
                        <path fill="#7fba00" d="M13 1h10v10H13z" />
                        <path fill="#00a4ef" d="M1 13h10v10H1z" />
                        <path fill="#ffb900" d="M13 13h10v10H13z" />
                    </svg>

                <% } %>

                <span>Continue with <%= provider.label %></span>

            </a>

        <% }) %>

    </div>

<% } %>
