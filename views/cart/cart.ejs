<% layout('layouts/base') %>
<% block('title', 'Shopping cart') %>
<% block('styles', '<link rel="stylesheet" href="' + asset('/styles/pages/cart.css') + '">') %>
<% block('scripts', '<script src="' + asset('/scripts/cart.js') + '" defer></script>') %>

<% const items = cart && cart.items ? cart.items : []; %>

<main class="page" id="main">

    <div class="container">

        <% if (items.length === 0) { %>

            <div class="card">
                <div class="empty-state">

                    <span class="empty-state__art">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2.5 4h2.4l2.2 10.6a1.7 1.7 0 0 0 1.7 1.4h8.4a1.7 1.7 0 0 0 1.6-1.3L20.5 8H6" />
                            <circle cx="9.5" cy="19.5" r="1.5" />
                            <circle cx="17" cy="19.5" r="1.5" />
                        </svg>
                    </span>

                    <h1 class="empty-state__title">Your cart is empty</h1>

                    <p class="empty-state__message">
                        Nothing here yet. Browse the store and anything you add
                        will show up on this page.
                    </p>

                    <div class="empty-state__actions">
                        <a class="btn btn--primary" href="/products">
                            Start shopping
                        </a>

                        <a class="btn btn--secondary" href="/orders">
                            View your orders
                        </a>
                    </div>

                </div>
            </div>

        <% } else { %>

            <div class="cart-layout">

                <section class="card cart-items" aria-labelledby="cart-heading">

                    <div class="cart-items__head">
                        <h1 class="page-title" id="cart-heading">Shopping cart</h1>

                        <p class="cart-items__count text-muted">
                            <span class="js-cart-label">
                                <%= cartQuantity === 1 ? '1 item' : cartQuantity + ' items' %>
                            </span>
                        </p>
                    </div>

                    <ul class="cart-items__list js-cart-list" data-max-quantity="<%= maxItemQuantity %>">

                        <% items.forEach((item) => { %>

                            <%
                                const productId = item.product._id;
                                const unitPrice = money(item.product.priceCents);
                                const linePrice = money(item.product.priceCents * item.quantity);
                            %>

                            <li class="cart-item js-cart-item" data-product-id="<%= productId %>">

                                <a class="cart-item__media" href="/products/<%= productId %>" tabindex="-1" aria-hidden="true">
                                    <img
                                        src="/<%= item.product.image %>"
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                    >
                                </a>

                                <div class="cart-item__body">

                                    <div class="cart-item__head">
                                        <h2 class="cart-item__title">
                                            <a href="/products/<%= productId %>">
                                                <span class="clamp-2"><%= item.product.name %></span>
                                            </a>
                                        </h2>

                                        <p class="price cart-item__price js-item-price" data-product-id="<%= productId %>">
                                            $<%= linePrice %>
                                        </p>
                                    </div>

                                    <p class="cart-item__meta">
                                        <span class="badge badge--success">In stock</span>
                                        <span class="text-muted">$<%= unitPrice %> each</span>
                                    </p>

                                    <div class="cart-item__actions">

                                        <div class="stepper js-stepper" data-product-id="<%= productId %>">
                                            <button
                                                type="button"
                                                class="stepper__button js-decrease"
                                                data-product-id="<%= productId %>"
                                                <%= item.quantity <= 1 ? 'disabled' : '' %>
                                            >
                                                <span aria-hidden="true">&minus;</span>
                                                <span class="visually-hidden">
                                                    Decrease quantity of <%= item.product.name %>
                                                </span>
                                            </button>

                                            <span
                                                class="stepper__value js-quantity"
                                                data-product-id="<%= productId %>"
                                                role="status"
                                            ><%= item.quantity %></span>

                                            <button
                                                type="button"
                                                class="stepper__button js-increase"
                                                data-product-id="<%= productId %>"
                                                <%= item.quantity >= maxItemQuantity ? 'disabled' : '' %>
                                            >
                                                <span aria-hidden="true">+</span>
                                                <span class="visually-hidden">
                                                    Increase quantity of <%= item.product.name %>
                                                </span>
                                            </button>
                                        </div>

                                        <button
                                            type="button"
                                            class="btn btn--sm btn--danger js-remove-item"
                                            data-product-id="<%= productId %>"
                                            data-product-name="<%= item.product.name %>"
                                        >
                                            <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M4 7h16M9.5 7V5h5v2M6.5 7l1 12.5h9l1-12.5" />
                                            </svg>
                                            Remove
                                        </button>

                                    </div>

                                </div>

                            </li>

                        <% }) %>

                    </ul>

                    <p class="cart-items__subtotal">
                        Subtotal
                        (<span class="js-cart-label"><%= cartQuantity === 1 ? '1 item' : cartQuantity + ' items' %></span>):
                        <strong class="price">$<span class="js-subtotal"><%= subtotal %></span></strong>
                    </p>

                </section>

                <aside class="card card--padded cart-summary" aria-label="Order summary">

                    <p class="cart-summary__subtotal">
                        Subtotal
                        (<span class="js-cart-label"><%= cartQuantity === 1 ? '1 item' : cartQuantity + ' items' %></span>):
                        <strong class="price price--lg">$<span class="js-subtotal"><%= subtotal %></span></strong>
                    </p>

                    <p class="cart-summary__note">
                        Shipping and tax are calculated at checkout.
                    </p>

                    <%# A link, not a button: this navigates. As a button it
                        did nothing without JavaScript, and could not be
                        opened in a new tab or middle-clicked. %>
                    <a class="btn btn--primary btn--lg btn--block js-checkout-link" href="/checkout">
                        Proceed to checkout
                    </a>

                    <a class="btn btn--secondary btn--block" href="/products">
                        Continue shopping
                    </a>

                    <p class="cart-summary__secure">
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="5" y="10.5" width="14" height="9.5" rx="2" />
                            <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
                        </svg>
                        Secure checkout
                    </p>

                </aside>

            </div>

        <% } %>

    </div>

</main>

<!-- Shown only after the visitor commits to leaving for checkout. -->
<div class="overlay js-checkout-overlay">
    <div class="overlay__box">
        <div class="spinner spinner--lg"></div>
        <p class="overlay__title">Opening checkout</p>
        <p class="overlay__message">One moment...</p>
    </div>
</div>
