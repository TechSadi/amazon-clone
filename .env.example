# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---- Required ----

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/amazon-clone

# Signs the session cookie. Use a long random value, unique per
# environment, and at least 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-value

# ---- Optional ----

# development | production
NODE_ENV=development

# Port the server listens on.
PORT=3000

# Name of the session cookie.
SESSION_NAME=amazon.sid

# bcrypt cost factor (10-15). Higher is slower and stronger.
BCRYPT_ROUNDS=12

# Set to true when running behind a reverse proxy (Render, Heroku,
# nginx) so secure cookies and client IPs work. Always on in production.
TRUST_PROXY=false

# ---- Social sign-in: Google and GitHub ----
#
# These are the supported providers. Fill in both pairs to enable
# social sign-in.
#
# Each provider is independent. Leave a pair blank and that provider's
# button simply does not appear on the sign-in and sign-up pages.
# Setting only one half of a pair is a startup error.
#
# The public origin of this site, with no trailing slash. Used to build
# the OAuth redirect URI, so it must match what you register with each
# provider exactly. Required in production when any provider is enabled.
BASE_URL=http://localhost:3000

# Google - https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application" and add this
# authorised redirect URI:  http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub - https://github.com/settings/developers
# New OAuth App. Authorization callback URL:
#   http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional: Microsoft (not configured, not required) ----
#
# Microsoft sign-in is implemented but switched off. The application
# runs exactly as intended with these left blank, and no Microsoft
# button is rendered.
#
# To enable it later, no code change is needed. Register an app at
# https://portal.azure.com (Entra ID > App registrations), add a Web
# platform redirect URI:
#   http://localhost:3000/auth/microsoft/callback
# create a client secret under "Certificates & secrets", then fill in
# both values below.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
