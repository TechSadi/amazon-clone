<% layout('layouts/base') %>
<% block('title', 'Your orders') %>
<% block('styles', '<link rel="stylesheet" href="' + asset('/styles/pages/orders.css') + '">') %>
<% block('scripts', '<script src="' + asset('/scripts/orders.js') + '" defer></script>') %>

<main class="page" id="main">

    <div class="container">

        <div class="page-header">
            <div>
                <h1 class="page-title">Your orders</h1>

                <p class="page-subtitle">
                    <%= orders.length %>
                    <%= orders.length === 1 ? 'order' : 'orders' %>
                </p>
            </div>

            <a class="btn btn--secondary" href="/products">Continue shopping</a>
        </div>

        <% if (orders.length === 0) { %>

            <div class="card">
                <div class="empty-state">

                    <span class="empty-state__art">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z" />
                            <path d="M3 7.5 12 12l9-4.5M12 12v9" />
                        </svg>
                    </span>

                    <h2 class="empty-state__title">No orders yet</h2>

                    <p class="empty-state__message">
                        Once you place an order it will appear here, along with
                        its delivery date and tracking.
                    </p>

                    <div class="empty-state__actions">
                        <a class="btn btn--primary" href="/products">
                            Start shopping
                        </a>
                    </div>

                </div>
            </div>

        <% } else { %>

            <div class="orders-list">

                <% orders.forEach((order) => { %>

                    <article class="card order">

                        <div class="card__header order__header">

                            <dl class="order__facts">

                                <div class="order__fact">
                                    <dt>Order placed</dt>
                                    <dd><%= order.placedOnLabel %></dd>
                                </div>

                                <div class="order__fact">
                                    <dt>Total</dt>
                                    <dd>$<%= order.totalLabel %></dd>
                                </div>

                                <div class="order__fact">
                                    <dt>Items</dt>
                                    <dd><%= order.itemCount %></dd>
                                </div>

                            </dl>

                            <dl class="order__facts order__facts--end">
                                <div class="order__fact">
                                    <dt>Order ID</dt>
                                    <dd class="order__id"><%= order.id %></dd>
                                </div>
                            </dl>

                        </div>

                        <ul class="order__items">

                            <% order.items.forEach((item) => { %>

                                <li class="order-item">

                                    <a class="order-item__media" href="/products/<%= item.productId %>" tabindex="-1" aria-hidden="true">
                                        <img src="/<%= item.image %>" alt="" loading="lazy" decoding="async">
                                    </a>

                                    <div class="order-item__details">

                                        <p class="order-item__status">
                                            <% if (item.isDelivered) { %>
                                                <span class="badge badge--success">Delivered</span>
                                                <span class="text-muted"><%= item.deliveryDateLabel %></span>
                                            <% } else { %>
                                                <span class="badge badge--info">On the way</span>
                                                <span class="text-muted">Arriving <%= item.deliveryDateLabel %></span>
                                            <% } %>
                                        </p>

                                        <h2 class="order-item__title">
                                            <a href="/products/<%= item.productId %>">
                                                <span class="clamp-2"><%= item.name %></span>
                                            </a>
                                        </h2>

                                        <p class="order-item__quantity text-muted">
                                            Quantity: <%= item.quantity %>
                                        </p>

                                    </div>

                                    <div class="order-item__actions">

                                        <button
                                            type="button"
                                            class="btn btn--primary btn--pill btn--block js-buy-again"
                                            data-product-id="<%= item.productId %>"
                                            data-quantity="<%= item.quantity %>"
                                            data-product-name="<%= item.name %>"
                                        >
                                            <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M4 9a8 8 0 1 1 .6 5" />
                                                <path d="M4 4v5h5" />
                                            </svg>
                                            Buy it again
                                        </button>

                                        <a
                                            class="btn btn--secondary btn--pill btn--block"
                                            href="/tracking/<%= order.id %>/<%= item.productId %>"
                                        >
                                            Track package
                                        </a>

                                    </div>

                                </li>

                            <% }) %>

                        </ul>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </div>

</main>
