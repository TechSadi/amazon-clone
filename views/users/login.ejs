<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="csrf-token" content="<%= csrfToken %>">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign in</title>

    <link rel="stylesheet" href="/styles/pages/users/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <script src="/scripts/users/login.js" defer></script>

</head>


<body>

    <main class="auth-page">

        <a href="/products" class="logo-container">

            <img src="/images/amazon-logo-white.png" alt="Amazon" class="amazon-logo">

        </a>


        <section class="auth-card">

            <div class="auth-header">

                <h1>Sign in</h1>

                <p>
                    Welcome back. Sign in to continue shopping.
                </p>

            </div>


            <% if (error) { %>

                <div class="server-error">

                    <svg viewBox="0 0 24 24">

                        <circle cx="12" cy="12" r="10"></circle>

                        <path d="M12 7v5"></path>

                        <circle cx="12" cy="16.5" r="1"></circle>

                    </svg>

                    <span>
                        <%= error %>
                    </span>

                </div>

                <% } %>


                    <form action="/users/login" method="POST" id="login-form" novalidate>

                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <!-- EMAIL -->

                        <div class="form-group">

                            <label for="email">
                                Email
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>

                                    <path d="M3 7l9 6 9-6"></path>

                                </svg>


                                <input type="email" id="email" name="email" placeholder="Enter your email"
                                    value="<%= formData?.email || '' %>" autocomplete="email">

                            </div>

                            <p class="field-message" id="email-error"></p>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <div class="label-row">

                                <label for="password">
                                    Password
                                </label>

                                <a href="#" class="forgot-password">
                                    Forgot password?
                                </a>

                            </div>


                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24">
                                    <rect x="5" y="10" width="14" height="10" rx="2"></rect>

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>

                                </svg>


                                <input type="password" id="password" name="password" placeholder="Enter your password"
                                    autocomplete="current-password">


                                <button type="button" class="toggle-password" aria-label="Show password">

                                    <svg viewBox="0 0 24 24">

                                        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>

                                        <circle cx="12" cy="12" r="3"></circle>

                                    </svg>

                                </button>

                            </div>

                            <p class="field-message" id="password-error"></p>

                        </div>


                        <button type="submit" class="signin-button">
                            Sign in
                        </button>

                    </form>


                    <p class="terms-text">

                        By continuing, you agree to our

                        <a href="#">
                            Conditions of Use
                        </a>

                        and

                        <a href="#">
                            Privacy Notice
                        </a>.

                    </p>


                    <div class="divider">

                        <span>
                            New to Amazon Clone?
                        </span>

                    </div>


                    <a href="/users/register" class="create-account-link">
                        Create your account
                    </a>


                    <%- include('../partials/social-buttons', {
                        dividerClass: 'social-divider',
                        dividerLabel: 'or continue with'
                    }) %>

        </section>


        <footer class="auth-footer">

            <div class="footer-links">

                <a href="#">Conditions of Use</a>
                <a href="#">Privacy Notice</a>
                <a href="#">Help</a>

            </div>

            <p>
                © 2026 Amazon Clone Project
            </p>

        </footer>

    </main>

</body>

</html>