<%#
  Shared document head.

  Title, page stylesheets and page scripts come from ejs-mate blocks that
  the view declares, so a page only ever loads its own CSS and JS on top
  of the two shared files.
%>
<%
    const documentTitle = String(block('title')).trim();
    const metaDescription = String(block('description')).trim();
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#131921">
<meta name="color-scheme" content="light">
<meta name="description" content="<%= metaDescription || 'Shop everyday essentials, apparel, kitchen and home products.' %>">
<%# The error page can be reached before the CSRF middleware has run. %>
<meta name="csrf-token" content="<%= typeof csrfToken === 'string' ? csrfToken : '' %>">

<title><%= documentTitle ? documentTitle + ' · Amazon Clone' : 'Amazon Clone' %></title>

<link rel="icon" href="/images/amazon-mobile-logo.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/styles/core.css">
<%- block('styles') %>

<script src="/scripts/core.js" defer></script>
<%- block('scripts') %>
